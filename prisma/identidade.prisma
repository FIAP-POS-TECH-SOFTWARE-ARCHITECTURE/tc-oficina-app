model Usuario {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  role       Role
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  movimentosEstoque MovimentoEstoque[]
  historicoStatusOs OsHistoricoStatus[]
  comprasSolicitadas RegistroCompra[] @relation("registro_compra_solicitado_por")
  comprasRecebidas   RegistroCompra[] @relation("registro_compra_recebido_por")

  @@map("usuarios")
}
