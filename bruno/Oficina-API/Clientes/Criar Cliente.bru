meta {
  name: Criar Cliente
  type: http
  seq: 1
}

post {
  url: {{url}}/clientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nome": "Fulano da Silva",
    "documento": "529.982.247-25",
    "email": "fulano@email.com",
    "telefone": "(11) 99999-9999",
    "endereco": "Rua das Flores, 100"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("clienteId", res.body.data.id);
    bru.setEnvVar("documentoCliente", res.body.data.documento);
  }
}
