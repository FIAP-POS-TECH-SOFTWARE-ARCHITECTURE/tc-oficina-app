meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@oficina.local",
    "senha": "ChangeMe!123"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.accessToken) {
    bru.setEnvVar("token", res.body.data.accessToken);
  }
}
