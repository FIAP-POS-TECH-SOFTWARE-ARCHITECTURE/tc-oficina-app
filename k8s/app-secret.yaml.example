#     --from-literal=SMTP_USER='' \
#     --from-literal=SMTP_PASS=''
apiVersion: v1
kind: Secret
metadata:
  name: oficina-secrets
  labels:
    app: oficina-api
type: Opaque
stringData:
  DATABASE_URL: "CHANGE_ME"
  JWT_SECRET: "CHANGE_ME"
  ADMIN_BOOTSTRAP_EMAIL: "CHANGE_ME"
  ADMIN_BOOTSTRAP_PASSWORD: "CHANGE_ME"
  SMTP_USER: ""
  SMTP_PASS: ""
