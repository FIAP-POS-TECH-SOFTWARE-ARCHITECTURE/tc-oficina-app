#     --from-literal=DATABASE_URL='postgresql://usuario:senha@host:5432/oficina' \
#     --from-literal=JWT_SECRET='<segredo>' \
#     --from-literal=ADMIN_BOOTSTRAP_EMAIL='admin@oficina.local' \
